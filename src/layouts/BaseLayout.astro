---
interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  section?: string;
  tags?: string[];
}

const {
  title,
  description,
  keywords = [],
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  section,
  tags = [],
} = Astro.props;

import { SITE_CONFIG } from '../lib/constants';
import { Header, Footer } from '../components/layout';
import { Meta, JsonLd } from '../components/seo';
import '../styles/global.css';

const fullTitle = title ? `${title} | ${SITE_CONFIG.name}` : SITE_CONFIG.name;
---

<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <Meta
      title={title}
      description={description}
      keywords={keywords}
      image={image}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      section={section}
      tags={tags}
    />
    
    <JsonLd 
      type="website" 
      data={{
        name: SITE_CONFIG.name,
        description: SITE_CONFIG.description,
        url: SITE_CONFIG.url,
      }}
    />
    
    {type === 'article' && (
      <JsonLd 
        type="article" 
        data={{
          title,
          description,
          image,
          publishedTime,
          modifiedTime,
          author,
          category: section,
          keywords,
          url: Astro.url.href,
        }}
      />
    )}
  </head>
  
  <body class="h-full flex flex-col bg-gray-50">
    <Header client:load />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  /* Additional global styles specific to layout */
</style>