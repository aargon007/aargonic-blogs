---

<BaseLayout 
  title="Blog" 
  description="Explore our latest insights on technology, fintech, IoT, security, AI, and acquisition trends. Stay informed with expert analysis and industry news."
  keywords={['blog', 'technology', 'fintech', 'iot', 'security', 'ai', 'acquisition', 'tech news', 'insights']}
>
  <div class="min-h-screen bg-gray-50">
    <!-- Hero Section -->
    <section class="bg-white border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="text-center space-y-6">
          <h1 class="text-4xl font-bold text-gray-900 sm:text-5xl">
            Our Blog
          </h1>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Stay ahead of the curve with insights on the latest trends in technology, 
            fintech, IoT, cybersecurity, AI, and industry acquisitions.
          </p>
          
          <!-- Search Bar -->
          <div class="max-w-2xl mx-auto mt-8">
            <SearchBar 
              client:load
              onSearch={(query) => {
                // Handle search functionality
                console.log('Search query:', query);
              }}
              placeholder="Search articles by title, content, or tags..."
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content -->
    <section class="py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
          
          <!-- Sidebar -->
          <aside class="lg:col-span-1">
            <div class="sticky top-8 space-y-8">
              
              <!-- Category Filter -->
              <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">
                  Filter by Category
                </h3>
                <CategoryFilter 
                  client:load
                  onCategoryChange={(category) => {
                    // Handle category filtering
                    console.log('Selected category:', category);
                  }}
                />
              </div>

              <!-- Popular Tags -->
              <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">
                  Popular Tags
                </h3>
                <div class="flex flex-wrap gap-2">
                  {['AI', 'Machine Learning', 'Blockchain', 'Cybersecurity', 'IoT', 'Cloud Computing', 'DevOps', 'Data Science'].map((tag) => (
                    <button
                      key={tag}
                      class="px-3 py-1 text-sm bg-gray-100 text-gray-700 rounded-full hover:bg-blue-100 hover:text-blue-700 transition-colors"
                    >
                      #{tag}
                    </button>
                  ))}
                </div>
              </div>

              <!-- Newsletter Signup -->
              <div class="bg-blue-50 rounded-lg border border-blue-200 p-6">
                <h3 class="text-lg font-semibold text-blue-900 mb-2">
                  Stay Updated
                </h3>
                <p class="text-blue-700 text-sm mb-4">
                  Get the latest articles delivered directly to your inbox.
                </p>
                <a 
                  href="/#newsletter" 
                  class="block w-full bg-blue-600 text-white text-center py-2 px-4 rounded-lg hover:bg-blue-700 transition-colors font-medium"
                >
                  Subscribe Now
                </a>
              </div>

            </div>
          </aside>

          <!-- Main Content -->
          <main class="lg:col-span-3">
            <BlogList 
              client:load
              initialData={mockBlogData} 
            />
          </main>

        </div>
      </div>
    </section>
  </div>
</BaseLayout>