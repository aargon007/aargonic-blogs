---
import ContactFormInfo from '../components/contact/ContactFormInfo';
import ContactHero from '../components/contact/ContactHero';
import FAQ from '../components/contact/FAQ';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../lib/constants';
---

<BaseLayout 
  title="Contact Us"
  description={`Get in touch with ${SITE_CONFIG.name} team. We'd love to hear from you about partnerships, collaborations, or any questions.`}
  keywords={['contact', 'get in touch', 'partnerships', 'collaboration', 'support']}
>

  <ContactHero />

  <!-- Contact Form & Info Section -->
  <ContactFormInfo client:load />

  <!-- FAQ Section -->
  <FAQ client:load />
</BaseLayout>