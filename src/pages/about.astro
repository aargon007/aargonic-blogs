---
import AboutHero from '../components/about/AboutHero';
import ExpertiseAreas from '../components/about/ExpertiseAreas';
import StorySection from '../components/about/StorySection';
import Values from '../components/about/Values';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../lib/constants';
---

<BaseLayout 
  title="About Us"
  description={`Learn more about ${SITE_CONFIG.name} - our mission, team, and expertise in technology, fintech, IoT, AI, and security insights.`}
  keywords={['about', 'technology experts', 'fintech', 'iot', 'ai', 'security', 'innovation']}
>
  <!-- Hero Section -->
  <AboutHero/>

  <!-- Story Section -->
  <StorySection/>

  <!-- Expertise Areas -->
  <ExpertiseAreas/>

  <!-- Values Section -->
  <Values/>

  <!-- Call to Action -->
  
</BaseLayout>