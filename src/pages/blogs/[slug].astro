---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Badge } from '../../components/ui';
import { formatDate } from '../../utils/format';
import { featuredPosts } from '../../constants/featuredPosts';

export async function getStaticPaths() {

  return featuredPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { slug } = Astro.params;

---

<BaseLayout 
  title={post.title}
  description={post.excerpt}
  keywords={post.seo.keywords}
  image={post.featuredImage}
  type="article"
  publishedTime={post.publishedAt?.toISOString()}
  modifiedTime={post.updatedAt?.toISOString()}
  author="Aargonic Team"
  section={post.category}
  tags={post.tags}
>
  <article class="min-h-screen bg-[var(--color-background)]">
    
    <!-- Hero Section -->
    <header class="relative">
      <div class="w-full h-[340px] overflow-hidden">
        <img 
          src={post.featuredImage || '/images/placeholder-blog-detail.jpg'} 
          alt={post.title}
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/30"></div>
      </div>
      
      <div class="absolute inset-0 flex items-end">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
          <div class="space-y-4">
            <Badge variant="primary">
              {post.category}
            </Badge>
            
            <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-[var(--color-text-primary)] leading-tight">
              {post.title}
            </h1>
            
            <div class="flex flex-wrap items-center text-[var(--color-text-secondary)] text-sm space-x-6">
              <span>{formatDate(post.publishedAt || post.createdAt)}</span>
              <span>•</span>
              <span>{post.readingTime} min read</span>
              <span>•</span>
              <span>{post.views} views</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Content -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-12">
        
        <!-- Article Content -->
        <main class="lg:col-span-3">
          <div class="prose prose-lg max-w-none text-[var(--color-text-primary)]">
            <div class="text-xl text-[var(--color-text-secondary)] mb-8 leading-relaxed">
              {post.excerpt}
            </div>
            
            <div class="prose-content" set:html={post.content.replace(/\n/g, '<br/>')} />
          </div>

          <!-- Tags -->
          <div class="mt-12 pt-8 border-t border-[var(--color-border)]">
            <h3 class="text-lg font-semibold text-[var(--color-text-primary)] mb-4">Tags</h3>
            <div class="flex flex-wrap gap-2">
              {post.tags.map((tag) => (
                <a 
                  href={`/blog?tag=${tag}`}
                  class="px-3 py-1 bg-[var(--color-surface-elevated)] text-[var(--color-text-secondary)] text-sm rounded-full hover:bg-[var(--color-primary-light)] hover:text-[var(--color-primary)] transition-colors"
                >
                  #{tag}
                </a>
              ))}
            </div>
          </div>

          <!-- Social Share -->
          <div class="mt-8 pt-8 border-t border-[var(--color-border)]">
            <h3 class="text-lg font-semibold text-[var(--color-text-primary)] mb-4">Share this article</h3>
            <div class="flex space-x-4">
              <a 
                href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(Astro.url.href)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center px-4 py-2 bg-[var(--color-primary)] text-[var(--color-background)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors"
              >
                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84" />
                </svg>
                Twitter
              </a>
              
              <a 
                href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center px-4 py-2 bg-[var(--color-primary)] text-[var(--color-background)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors"
              >
                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
                LinkedIn
              </a>
            </div>
          </div>
        </main>

        <!-- Sidebar -->
        <aside class="lg:col-span-1">
          <div class="sticky top-8 space-y-8">
            
            <!-- Author Info -->
            <div class="bg-[var(--color-surface-elevated)] rounded-lg p-6">
              <div class="flex items-center space-x-4 mb-4">
                <img 
                  src="/images/authors/team-avatar.jpg" 
                  alt="Author"
                  class="w-12 h-12 rounded-full object-cover"
                />
                <div>
                  <h4 class="font-semibold text-[var(--color-text-primary)]">Aargonic Team</h4>
                  <p class="text-sm text-[var(--color-text-secondary)]">Technology Experts</p>
                </div>
              </div>
              <p class="text-sm text-[var(--color-text-secondary)]">
                Our team of technology experts brings decades of experience in fintech, 
                IoT, cybersecurity, and emerging technologies.
              </p>
            </div>

            <!-- Table of Contents -->
            <div class="bg-[var(--color-surface-elevated)] border border-[var(--color-border)] rounded-lg p-6">
              <h4 class="font-semibold text-[var(--color-text-primary)] mb-4">Table of Contents</h4>
              <nav class="space-y-2">
                {['current-landscape','ai-impact','challenges','road-ahead','conclusion'].map((id) => (
                  <a href={`#${id}`} class="block text-sm text-[var(--color-primary)] hover:text-[var(--color-primary-hover)]">
                    {id.replace(/-/g,' ')}
                  </a>
                ))}
              </nav>
            </div>

            <!-- Newsletter CTA -->
            <div class="bg-[var(--color-primary-light)] border border-[var(--color-primary)] rounded-lg p-6">
              <h4 class="font-semibold text-[var(--color-primary)] mb-2">Stay Updated</h4>
              <p class="text-sm text-[var(--color-primary)] mb-4">
                Get more insights like this delivered to your inbox.
              </p>
              <a 
                href="/#newsletter" 
                class="block w-full bg-[var(--color-primary)] text-[var(--color-background)] text-center py-2 px-4 rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors font-medium text-sm"
              >
                Subscribe Now
              </a>
            </div>

          </div>
        </aside>

      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .prose-content {
    color: var(--color-text-primary);
    line-height: 1.75;
  }
  
  .prose-content h1,
  .prose-content h2,
  .prose-content h3,
  .prose-content h4,
  .prose-content h5,
  .prose-content h6 {
    font-weight: 700;
    color: var(--color-text-primary);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  
  .prose-content h1 { font-size: 2rem; }
  .prose-content h2 { font-size: 1.75rem; }
  .prose-content h3 { font-size: 1.5rem; }
  .prose-content h4 { font-size: 1.25rem; }
  
  .prose-content p {
    margin-bottom: 1.5rem;
  }
  
  .prose-content ul,
  .prose-content ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  
  .prose-content li {
    margin-bottom: 0.5rem;
  }
  
  .prose-content blockquote {
    border-left: 4px solid var(--color-primary);
    padding-left: 1.5rem;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    margin: 1.5rem 0;
    font-style: italic;
    background-color: var(--color-primary-light);
    color: var(--color-text-secondary);
  }
  
  .prose-content code {
    background-color: var(--color-surface-elevated);
    padding: 0.125rem 0.25rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    font-family: monospace;
  }
  
  .prose-content strong {
    font-weight: 600;
    color: var(--color-text-primary);
  }
</style>
