---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Hero, FeaturedPosts, CategorySection } from '../components/home';
import { SITE_CONFIG } from '../lib/constants';
import { featuredPosts } from '../constants/featuredPosts';

---

<BaseLayout 
  title="Home"
  description={SITE_CONFIG.description}
  keywords={['technology', 'fintech', 'iot', 'security', 'ai', 'acquisition', 'innovation']}
>
  <Hero client:load />
  <FeaturedPosts posts={featuredPosts} client:load />
  <CategorySection client:load />
</BaseLayout>